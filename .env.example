# =============================================================
# SIPKO - Sistem Peminjaman Kendaraan Operasional
# SMKN 1 Subang
# .env.example — JANGAN isi nilai rahasia di file ini
# Salin ke .env.local dan isi nilai sebenarnya
# =============================================================

# --- DATABASE (MySQL / MariaDB pada aaPanel atau XAMPP) ---
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/sipko_db"

# --- NEXTAUTH ---
NEXTAUTH_URL="https://sipko.smkn1subang.sch.id"
NEXTAUTH_SECRET="ganti-dengan-string-random-minimal-32-karakter"
# Generate di terminal Linux: openssl rand -base64 32

# --- APLIKASI ---
APP_URL="https://sipko.smkn1subang.sch.id"
APP_NAME="SIPKO"
SCHOOL_NAME="SMKN 1 Subang"
SCHOOL_ADDRESS="Jl. Arief Rahman Hakim No.40, Sukarahayu, Kec. Subang, Kabupaten Subang, Jawa Barat 41212"
SCHOOL_LAT="-6.5694"
SCHOOL_LNG="107.7588"

# --- FILE STORAGE (path absolut, DI LUAR folder public/) ---
# Pada Linux aaPanel: /www/wwwroot/sipko/uploads
# Windows dev: D:/sipko-uploads
UPLOAD_DIR="/www/wwwroot/sipko/uploads"
MAX_FILE_SIZE_MB="10"

# --- WHATSAPP (Baileys) ---
# Pada Linux aaPanel: /www/wwwroot/sipko/wa-session
# Windows dev: D:/sipko-wa-session
WA_SESSION_DIR="/www/wwwroot/sipko/wa-session"
WA_ADMIN_NUMBERS=""
# Format: 6281234567890,6289876543210 (dengan kode negara, tanpa +)

# --- REDIS (untuk BullMQ notification queue) ---
REDIS_URL="redis://localhost:6379"

# --- PETA / GEOCODING ---
MAP_PROVIDER="osm"
# osm = OpenStreetMap Nominatim + OSRM (gratis, default)
# google = Google Maps Platform (butuh API key di bawah)
GOOGLE_MAPS_API_KEY=""
# Hanya digunakan jika MAP_PROVIDER=google

# --- EMAIL / SMTP (opsional, untuk reset password admin) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@sipko.smkn1subang.sch.id"

# --- MODE APLIKASI ---
NODE_ENV="development"
# production | development
# Dalam development mode: WhatsApp menampilkan QR, notifikasi log ke console
